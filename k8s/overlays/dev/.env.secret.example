DB_USER=app_runtime
DB_PASSWORD=change-me
REDIS_PASSWORD=

# HMAC master key for GitHub webhook secrets. staging/prod refuse the repo dev default and any
# value shorter than 32 chars (this placeholder starts with the dev marker on purpose, so copying
# it verbatim fails startup instead of running with a public key). Generate: openssl rand -hex 32
WEBHOOK_SECRET_MASTER_KEY=dev-webhook-REPLACE-ME
