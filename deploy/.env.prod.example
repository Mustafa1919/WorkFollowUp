# Uretim sirlari sablonu. Gercek degerlerle doldurup deploy/.env.prod olarak kaydedin
# (o dosya .gitignore'da, asla commit edilmez). chmod 600 uygulayin.
# Uretim komutu: docker compose -f docker-compose.yml -f docker-compose.app.yml \
#   -f docker-compose.prod.yml --env-file deploy/.env.prod up -d
# Her degerin nereden geldigi icin docs/DEPLOYMENT.md Bolum 5 ve 7'ye bakin.

GHCR_OWNER=owner-kucuk-harf
IMAGE_TAG=commit-sha

# Postgres app_migrator (bootstrap/owner). Ilk acilista POSTGRES_PASSWORD olarak okunur.
DB_MIGRATOR_PASSWORD=

# Postgres app_runtime. init-roles-and-dbs.sh bunu 'app_runtime' olarak sabit kodluyor --
# ilk acilistan SONRA elle ALTER ROLE ile degistirilip buraya yazilmali (bkz. DEPLOYMENT.md SS7).
DB_RUNTIME_PASSWORD=

REDIS_PASSWORD=

WEBHOOK_SECRET_MASTER_KEY=

APP_PUBLIC_URL=https://app.example.com

# Virgulle ayrilmis, ilk giriste SYSTEM_ADMIN isaretlenecek e-posta(lar)
SYSTEM_ADMIN_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@app.example.com
